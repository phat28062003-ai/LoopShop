{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://loopshop.onrender.com/api/:path*"
    },
    {
      "source": "/media/:path*",
      "destination": "https://loopshop.onrender.com/media/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}
